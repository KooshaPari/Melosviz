{
  "name": "@melosviz/bridge-client",
  "version": "0.0.0",
  "description": "MelosViz HTTP bridge client stub (WBS-P3.1). Published to GitHub Packages via publish-sdk-packages workflow.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KooshaPari/Melosviz.git",
    "directory": "sdk/ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "check": "node -e \"require('node:fs').accessSync('src/index.ts')\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "melosviz",
    "bridge",
    "stub"
  ]
}
