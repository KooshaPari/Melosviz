{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "melosviz://i18n/schema.json",
  "title": "MelosViz i18n message schema",
  "type": "object",
  "additionalProperties": {
    "type": "string",
    "minLength": 1
  },
  "required": [
    "app.title",
    "splash.status.loading",
    "splash.status.ready",
    "splash.status.connecting",
    "splash.status.error",
    "spec.upload.title",
    "spec.upload.hint",
    "spec.view.title",
    "spec.view.why_label",
    "spec.view.how_label",
    "spec.progress.decode",
    "spec.progress.route",
    "spec.progress.mux",
    "spec.progress.complete",
    "spec.progress.error",
    "spec.progress.eta",
    "palette.placeholder",
    "palette.no_matches",
    "inspect.decisions",
    "inspect.no_decisions",
    "error.boundary.title",
    "error.boundary.refresh",
    "error.boundary.copy_id",
    "error.boundary.copied",
    "error.boundary.copied_id",
    "confetti.celebrate",
    "keyboard.undo",
    "keyboard.redo",
    "keyboard.save",
    "keyboard.palette",
    "keyboard.inspect",
    "common.cancel",
    "common.close",
    "common.retry",
    "common.offline"
  ]
}
