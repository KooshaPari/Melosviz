{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "wav_path": {
            "title": "Wav Path",
            "type": "string"
          }
        },
        "required": [
          "wav_path"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "BuildRequest": {
        "properties": {
          "out_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Out Dir"
          },
          "wav_path": {
            "title": "Wav Path",
            "type": "string"
          }
        },
        "required": [
          "wav_path"
        ],
        "title": "BuildRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RenderRequest": {
        "properties": {
          "out_dir": {
            "title": "Out Dir",
            "type": "string"
          },
          "wav_path": {
            "title": "Wav Path",
            "type": "string"
          }
        },
        "required": [
          "wav_path",
          "out_dir"
        ],
        "title": "RenderRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "MelosViz bridge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analyze": {
      "post": {
        "description": "Analyze a WAV file and return the RenderSpec as JSON text.\n\nUses the fast Rust MIR analyzer when available; falls back to Python.",
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze"
      }
    },
    "/build": {
      "post": {
        "description": "Analyze a WAV then assemble a render plan; return plan JSON.\n\nUses the fast Rust MIR analyzer when available; falls back to Python.",
        "operationId": "build_build_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuildRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Build"
      }
    },
    "/debug/profile": {
      "get": {
        "description": "Opt-in CPU profile sample (enable with ``MELOSVIZ_PROFILE=1``).\n\nReturns a short ``cProfile`` dump for a trivial workload so operators can\nconfirm the profiler path without attaching an external agent. Disabled\n(404) unless explicitly enabled \u2014 keeps the default attack surface small.",
        "operationId": "debug_profile_debug_profile_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Debug Profile Debug Profile Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Debug Profile"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus-text metrics for request counts, errors, and latency.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness probe \u2014 green once the bridge process is serving.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready"
      }
    },
    "/render": {
      "post": {
        "description": "Run the full conductor pipeline; return output directory path.\n\nUses the fast Rust MIR analyzer when available; falls back to Python.",
        "operationId": "render_render_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Render"
      }
    }
  }
}
