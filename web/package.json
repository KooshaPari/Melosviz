    "@radix-ui/react-slider": "^1.4.7",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.0.0",
    "@tauri-apps/api": "^2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
