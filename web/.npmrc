# @testing-library/react@15 declares `peerOptional @types/react ^18` while this project
# pins `@types/react ^19`, so npm's strict peer resolution refuses to install: both
# `npm ci` and `npm install` fail with ERESOLVE, which is what broke the web job the first
# time it actually ran in CI.
#
# Accepting the mismatch here (rather than per-invocation flags) keeps CI and local
# installs identical. The React 19 test surface works against v15 as-is.
# Proper fix to revisit: bump @testing-library/react to a major that supports React 19.
legacy-peer-deps=true
